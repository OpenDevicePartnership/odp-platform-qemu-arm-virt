#!/bin/sh
# Pre-commit hook installed by husky-rs: checks formatting and runs clippy on the Rust projects.
#
# SPDX-License-Identifier: MIT
#

set -e

UCSI_SMOKE="postbuild/os/windows-acpi-e2e/adapters/ucsi/smoke"
PROJECTS="e2e-tests mod/secure-services/platform $UCSI_SMOKE"

echo "=== pre-commit: checking Rust formatting ==="
for proj in $PROJECTS; do
    echo "  -> $proj"
    (cd "$proj" && cargo fmt -- --check)
done

echo "=== pre-commit: running clippy ==="
for proj in $PROJECTS; do
    echo "  -> $proj"
    (cd "$proj" && cargo clippy --locked -- -D warnings)
done

echo "=== pre-commit: running UCSI smoke tests ==="
(cd "$UCSI_SMOKE" && cargo test --locked)

echo "=== pre-commit: all checks passed ==="
