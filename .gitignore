# Top-level ignore rules for the ODP Platform firmware repository
#
# SPDX-License-Identifier: MIT
#

# Generated by Cargo
# will have compiled files and executables
debug/
target/
Build/
BaseTools/
.venv/
.sccache/
/docs/book/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Ignore dtb files they are generated from dts files
*.dtb
*.stamp

# OS Images should not be included
*.iso
*.qcow2
*.vhdx
/postbuild/os/build/
/.e2e/
